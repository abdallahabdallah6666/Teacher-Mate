# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public HTTPS origin for Chargily callbacks.
APP_URL="MY_APP_URL"

# Chargily Pay V2: test_sk_... uses sandbox; live_sk_... uses production.
# Server-side only. Also verifies Chargily webhook signatures.
CHARGILY_SECRET_KEY=""

# LicenseSeat: server-side secret with licenses:create and licenses:validate scopes.
LICENSESEAT_SECRET_KEY=""
LICENSESEAT_PRODUCT_SLUG=""
# Exact plan keys copied from LicenseSeat's Plans page.
LICENSESEAT_PLAN_KEY_SINGLE=""
LICENSESEAT_PLAN_KEY_PRO=""
LICENSESEAT_PLAN_KEY_SCHOOL=""

# Resend: server-side transactional email API key and verified-domain sender.
RESEND_API_KEY=""
LICENSE_EMAIL_FROM="Teacher Mate <licenses@example.com>"

# Cloud SQL for PostgreSQL, provisioned through AI Studio's Enable Cloud SQL flow.
# INSTANCE_CONNECTION_NAME format: project-id:region:instance-name.
# Runtime service identity requires Cloud SQL Client (roles/cloudsql.client).
INSTANCE_CONNECTION_NAME=""
DB_USER=""
DB_NAME=""
# Set DB_PASS as a server-side secret; never commit or paste it into chat.
DB_PASS=""
# Optional: PRIVATE when the instance and Cloud Run VPC are configured for private IP.
CLOUD_SQL_IP_TYPE="PUBLIC"
