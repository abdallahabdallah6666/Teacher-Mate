# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public HTTPS origin for this app; used to construct Chargily callbacks.
APP_URL="MY_APP_URL"

# Chargily Pay V2: test_sk_... uses sandbox; live_sk_... uses production.
# Server-side only. Also verifies Chargily webhook signatures.
CHARGILY_SECRET_KEY=""

# LicenseSeat: server-side secret with licenses:create and licenses:validate scopes.
LICENSESEAT_SECRET_KEY=""
LICENSESEAT_PRODUCT_SLUG=""
# Use plan keys copied from LicenseSeat's Plans page (not plan display names or UUIDs).
LICENSESEAT_PLAN_KEY_SINGLE=""
LICENSESEAT_PLAN_KEY_PRO=""
LICENSESEAT_PLAN_KEY_SCHOOL=""

# Resend: server-side transactional email API key and sender on a verified domain.
RESEND_API_KEY=""
LICENSE_EMAIL_FROM="Teacher Mate <licenses@example.com>"
